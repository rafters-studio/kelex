{
  "name": "kelex",
  "version": "0.1.2",
  "description": "Zod schema in, form out — a config-driven form plugin host.",
  "keywords": [
    "codegen",
    "form",
    "plugin",
    "zod"
  ],
  "homepage": "https://rafters.studio/tools/kelex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafters-studio/kelex.git",
    "directory": "packages/kelex"
  },
  "bin": {
    "kelex": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./introspection": {
      "types": "./dist/introspection.d.ts",
      "import": "./dist/introspection.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js"
    },
    "./schema-writer": {
      "types": "./dist/schema-writer.d.ts",
      "import": "./dist/schema-writer.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.spec.ts'",
    "test:unit": "vitest run --exclude '**/*.spec.ts'",
    "test:spec": "vitest run test/cli.spec.ts test/stress/stress.spec.ts",
    "test:all": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
