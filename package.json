{
  "name": "kelex",
  "version": "0.1.2",
  "description": "Zod schema in, form out — a config-driven form plugin host.",
  "keywords": [
    "codegen",
    "form",
    "plugin",
    "zod"
  ],
  "homepage": "https://rafters.studio/tools/kelex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafters-studio/kelex.git"
  },
  "bin": {
    "kelex": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./introspection": {
      "types": "./dist/introspection.d.ts",
      "import": "./dist/introspection.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js"
    },
    "./schema-writer": {
      "types": "./dist/schema-writer.d.ts",
      "import": "./dist/schema-writer.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm -r --filter=\"./packages/*\" build",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && pnpm -r --filter=\"./packages/*\" typecheck",
    "test": "vitest run --exclude '**/*.spec.ts' && pnpm -r --filter=\"./packages/*\" test",
    "test:unit": "vitest run --exclude '**/*.spec.ts' && pnpm -r --filter=\"./packages/*\" test:unit",
    "test:all": "vitest run && pnpm -r --filter=\"./packages/*\" test:all",
    "lint": "oxlint src test packages scripts",
    "lint:fix": "oxlint --fix src test packages scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preflight": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit",
    "flightcheck": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test:all",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@kelex/plugin-handler-post": "workspace:*",
    "@kelex/plugin-renderer-html": "workspace:*",
    "@types/node": "^25.0.9",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.0.15",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
