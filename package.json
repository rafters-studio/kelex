{
  "name": "kelex-monorepo",
  "private": true,
  "description": "kelex — Zod schema in, form out. Config-driven plugin host + default plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafters-studio/kelex.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:all": "pnpm -r test:all",
    "lint": "oxlint packages",
    "lint:fix": "oxlint --fix packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preflight": "pnpm lint && pnpm build && pnpm typecheck && pnpm -r test:unit",
    "flightcheck": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm -r test:all"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.0.15",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
